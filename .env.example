PORT=3000

# Messaging API（建議與 backup/.env 相同命名）
CHANNEL_Daily_Health_Check_ACCESS_TOKEN=
CHANNEL_Daily_Health_Check_SECRET=

# 相容舊名（擇一即可；若已填上面兩行可留空）
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# Rich Menu／PWA 公開網址，必須 https
# 例：https://your-domain.com 或 https://xxxx.ngrok-free.app
PUBLIC_APP_URL=

# 選填：自訂 SQLite 路徑
# HEALTH_DB_PATH=C:\\path\\to\\health.sqlite
